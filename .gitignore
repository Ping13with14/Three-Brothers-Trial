# Unity 项目标准 gitignore
# 这些文件夹是 Unity 自动生成的，不需要上传

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# IDE 和工具
.vs/
.idea/
*.csproj
*.sln
*.user
*.userosscache
*.suo
*.userprefs

# 内存/崩溃报告
[Mm]emoryCaptures/
[Cr]ashReports/

# 资源服务器
[Aa]sset[Ss]erver/

# 缓存的资源包
*.unitypackage
*.cubemap

# TextMesh Pro 生成的 SDF 字体资产（体积大，可从源字体重新生成）
Assets/Fonts/*SDF*
