  lines:
  - speaker: {fileID: 11400000, guid: fad9a2135a660fb4dbd58f5d710a10e0, type: 2}
    text: "\u73B0\u5728\u8BE5\u5B66\u4E60\u5982\u4F55\u7BA1\u7406\u7269\u8D44\u4E86\u3002\u68EE\u6797\u4E2D\u751F\u957F\u7740\u4E00\u79CD\u6FC0\u7D20\u8611\u83C7\uFF0C\u80FD\u5728\u77ED\u65F6\u95F4\u5185\u63D0\u5347\u901F\u5EA6\u548C\u751F\u547D\u4E0A\u9650\u3002\u6536\u96C63\u4E2A\u56DE\u6765\u3002"
  - speaker: {fileID: 11400000, guid: fad9a2135a660fb4dbd58f5d710a10e0, type: 2}
    text: "\u53E6\u5916\uFF0C\u53BB\u68EE\u6797\u91CC\u7684\u5546\u5E97\u770B\u770B\u3002\u548CShopKeeper\u4EA4\u4E92\u53EF\u4EE5\u4E70\u5356\u7269\u54C1\u3002\u5356\u6389\u591A\u4F59\u7684\u7269\u54C1\u6362\u53D6\u91D1\u5E01\uFF0C\u518D\u4E70\u4E00\u652F\u7BAD\u77E2\u3002\u7BAD\u77E2\u53EF\u4EE5\u642D\u914D\u5F13\u7BAD\u5728\u8FDC\u7A0B\u653B\u51FB\u4E2D\u4F7F\u7528\u3002"
