  lines:
  - speaker: {fileID: 11400000, guid: fad9a2135a660fb4dbd58f5d710a10e0, type: 2}
    text: "\u52C7\u8005\uFF0C\u6B22\u8FCE\u6765\u5230\u7EFF\u4E18\uFF01\u6211\u662FPurple
      Bob\uFF0C\u4E09\u5144\u5F1F\u4E2D\u7684\u5927\u54E5\u3002\u9ED1\u6697\u6B63\u5728\u4FB5\u8680\u8FD9\u7247\u571F\u5730\uFF0C\u6211\u4EEC\u9700\u8981\u56E2\u7ED3\u4E00\u81F4\u624D\u80FD\u5BF9\u6297\u5B83\u3002"
  - speaker: {fileID: 11400000, guid: fad9a2135a660fb4dbd58f5d710a10e0, type: 2}
    text: "\u9996\u5148\uFF0C\u8BF7\u627E\u5230\u6211\u7684\u4E24\u4E2A\u5F1F\u5F1F\u2014\u2014Blue
      Bob\u548CYellow Bob\u3002\u4ED6\u4EEC\u5C31\u5728\u9644\u8FD1\u3002\u4E09\u5144\u5F1F\u91CD\u805A\u540E\uFF0C\u6211\u624D\u80FD\u544A\u8BC9\u4F60\u63A5\u4E0B\u6765\u7684\u8BA1\u5212\u3002"
