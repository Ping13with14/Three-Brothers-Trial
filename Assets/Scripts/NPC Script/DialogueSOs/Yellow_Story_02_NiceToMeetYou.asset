  - speaker: {fileID: 11400000, guid: cf20ea5a3b09a2c418c0e40813b438fc, type: 2}
    text: "Purple\u5927\u54E5\u80AF\u5B9A\u7B49\u6025\u4E86\uFF0C\u4F60\u5FEB\u56DE\u53BB\u627E\u4ED6\u5427\u3002\u6211\u4EEC\u4E09\u5144\u5F1F\u90FD\u4F1A\u652F\u6301\u4F60\u7684\uFF01"
