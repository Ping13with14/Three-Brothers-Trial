  - speaker: {fileID: 11400000, guid: fad9a2135a660fb4dbd58f5d710a10e0, type: 2}
    text: "\u4F60\u627E\u5230\u4E86\u8DEF\u724C\u548C\u7A3B\u8349\u4EBA\uFF01\u8DEF\u724C\u53EF\u4EE5\u5728\u8FF7\u5BAB\u4E2D\u6307\u5F15\u4F60\uFF0C\u7A3B\u8349\u4EBA\u5219\u80FD\u4FDD\u62A4\u4F60\u514D\u53D7\u5F31\u5C0F\u602A\u7269\u7684\u4FB5\u6270\u3002\u5B83\u4EEC\u73B0\u5728\u90FD\u5C5E\u4E8E\u4F60\u4E86\u3002"
  - speaker: {fileID: 11400000, guid: fad9a2135a660fb4dbd58f5d710a10e0, type: 2}
    text: "\u53EA\u5269\u6700\u540E\u4E00\u9879\u8BD5\u70BC\u4E86\u3002\u5B8C\u6210\u5B83\uFF0C\u4F60\u5C06\u6210\u4E3A\u7EFF\u4E18\u771F\u6B63\u7684\u5B88\u62A4\u8005\u3002"
